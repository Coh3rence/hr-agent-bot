# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_from_botfather

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Sheets
GOOGLE_SHEETS_ID=your_google_sheets_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----"

# Collabberry Beta App
# API base URL — must include the /api prefix.
BETA_APP_API_URL=https://beta.collabberry.xyz/api
# Admin-scoped bearer JWT (the bot creates agreements as an org admin).
# Expires every 7 days — prefer BETA_APP_SERVICE_KEY below for unattended use.
BETA_APP_JWT=your_admin_jwt_token
# Shared service-key for unattended auth (sent as X-Service-Key). Must match the
# backend's SERVICE_API_KEY; the fork impersonates SERVICE_ADMIN_WALLET on a match.
# No expiry, no wallet key on the bot. Takes precedence over BETA_APP_JWT.
BETA_APP_SERVICE_KEY=your_shared_service_key
# Org the bot creates agreements in (used to read the contributor roster).
BETA_APP_ORG_ID=your_org_uuid
# Where the contributor self-registers; the bot appends ?invitation=<token>.
BETA_APP_INVITE_URL=https://beta.collabberry.xyz/join

# Compensation mapping (D-013/D-015)
# FTE basis for hourly -> monthly marketRate conversion (40h x 4wk).
FTE_HOURS_PER_MONTH=160
# Fiat slice of monthly comp; remainder paid in TeamPoints. 0 = all TeamPoints.
DEFAULT_FIAT_REQUESTED=0

# Bot Configuration
REVIEWER_TIMEOUT_HOURS=48
MAX_NEGOTIATION_ROUNDS=2
COOLDOWN_DAYS=3
